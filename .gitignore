*.key

# Local archived weights and caches remain outside Git.
history/**/checkpoints/
history/**/*.pt
history/**/*.pth

# E14 derived numeric input caches and full layout traces stay local.
experiments/E14_stable_teacher/runs/**/train.json
experiments/E14_stable_teacher/runs/**/dev.json
experiments/E14_stable_teacher/runs/**/results.json
experiments/E14_stable_teacher/runs/**/*.npz
experiments/E14_stable_teacher/runs/teacher_*/
experiments/E14_stable_teacher/runs/**/*.tmp
experiments/E14_stable_teacher/runs/background_generation/

# Shared E15 numeric training caches are rebuildable local data.
experiments/E15_quality_curriculum/runs/prepared_v4_cache_v1/
experiments/E15_quality_curriculum/runs/**/cache/
experiments/E15_quality_curriculum/runs/**/*.tmp

# E16 original-reference caches and per-shard candidate metadata are local.
experiments/E16_reference_curriculum/runs/prepared_v5_cache_v1/
experiments/E16_reference_curriculum/runs/**/cache/
experiments/E16_reference_curriculum/runs/**/shards/
experiments/E16_reference_curriculum/runs/**/*.tmp
experiments/E16_reference_curriculum/runs/**/*.lock
protocol/reference_workset_v5.lock

# Generated teacher databases and prepared tensors are local artifacts.
experiments/E12_distillation_readiness/runs/teacher_*/
**/runs/**/prepared_*/
**/runs/**/*.npz
**/runs/**/*.sqlite3
**/runs/**/*.sqlite3-*
**/runs/**/*.tmp
**/runs/**/*.lock
# Preserve the same exclusions when retiring an experiment into history.
history/**/experiments/E14_stable_teacher/runs/**/train.json
history/**/experiments/E14_stable_teacher/runs/**/dev.json
history/**/experiments/E14_stable_teacher/runs/**/results.json
history/**/experiments/E14_stable_teacher/runs/teacher_*/
history/**/experiments/E14_stable_teacher/runs/background_generation/
history/**/experiments/E12_distillation_readiness/runs/teacher_*/
history/**/experiments/E15_quality_curriculum/runs/**/cache/
history/**/experiments/E16_reference_curriculum/runs/**/cache/
history/**/experiments/E16_reference_curriculum/runs/**/shards/

# E30/E31 retain full layouts, checkpoints and source snapshots locally.
# Compact summaries, source identities, reports and figures remain versioned.
experiments/E30_stable_fast_geometry/runs/**/results.json
!experiments/E30_stable_fast_geometry/runs/20261022_training_seed*/**/results.json
experiments/E30_stable_fast_geometry/runs/**/partial.json
experiments/E30_stable_fast_geometry/runs/**/source_snapshot.zip
experiments/E31_conic_workspace_reuse/runs/20261022_real_case_check/results.json
experiments/E31_conic_workspace_reuse/runs/**/partial.json
experiments/E31_conic_workspace_reuse/runs/**/source_snapshot.zip
